# ─────────────────────────────────────────────────────────────
# BARBERVERSE 3D — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────

# Banco de dados
# Desenvolvimento (zero configuração): SQLite local
DATABASE_URL="file:./dev.db"
# Produção (Supabase Postgres): troque o provider em prisma/schema.prisma para "postgresql"
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# URL pública da aplicação (links de e-mail, convites, recuperação de senha)
APP_URL="http://localhost:3000"

# Identificador da barbearia atendida por esta instalação
SHOP_SLUG="barberverse"

# Token de configuração inicial (rota /setup). Necessário para criar o PRIMEIRO
# administrador quando o banco não tem nenhum. Use um valor longo e aleatório.
SETUP_TOKEN="troque-por-um-valor-longo-e-aleatorio"

# Segredo para o endpoint de processamento da fila de notificações (/api/cron/notifications)
CRON_SECRET="troque-por-outro-valor-aleatorio"

# Diretório de armazenamento de arquivos enviados (fotos, logotipo)
UPLOAD_DIR="./storage/uploads"

# ── Integrações opcionais (deixe vazio se não tiver credenciais) ──
# E-mail transacional via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Barberverse <agenda@seu-dominio.com.br>"

# WhatsApp Business Cloud API (Meta) — requer templates aprovados
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_LANG="pt_BR"

# Pagamentos online (ainda NÃO integrados — ver docs/PAGAMENTOS.md)
MERCADOPAGO_ACCESS_TOKEN=""
